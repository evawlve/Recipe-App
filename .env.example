# Database
# Pooled (pgBouncer) URL for app/runtime (replace host/project suffix)
DATABASE_URL="postgresql://postgres.<project_ref>:password@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Direct URL for migrations/Prisma (unpooled 5432)
DIRECT_URL="postgresql://postgres:password@db.<project_ref>.supabase.co:5432/postgres?sslmode=require"

# AWS S3 Configuration (Required)
AWS_REGION=us-east-2
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# CloudFront CDN Configuration (Recommended for better performance)
# Server-side (used to build full image URLs)
CLOUDFRONT_IMAGE_BASE=https://dXXXXXXXXXXXXX.cloudfront.net
# Client-side (for preconnect and next.config.ts remotePatterns)
NEXT_PUBLIC_CLOUDFRONT_HOST=dXXXXXXXXXXXXX.cloudfront.net
# Alternative client-side base URL (used if CLOUDFRONT_IMAGE_BASE not set)
NEXT_PUBLIC_CLOUDFRONT_IMAGE_BASE=https://dXXXXXXXXXXXXX.cloudfront.net
# Legacy (deprecated, use CLOUDFRONT_IMAGE_BASE instead)
# S3_PUBLIC_BASE_URL=https://your-cloudfront-domain.com

# Site Configuration
# Public site URL (used for generating absolute URLs)
NEXT_PUBLIC_SITE_URL=https://your-site.com

# Supabase Configuration (Required for Authentication & RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# USDA Food Database API (Optional - for nutrition data)
FDC_API_KEY=your-usda-api-key
# FDC API rate limit per hour (default: 1000)
FDC_RATE_LIMIT_PER_HOUR=1000
# Enable USDA bulk import (default: false)
USDA_BULK_IMPORT_ENABLED=false

# Feature Flags
FOOD_MAPPING_V2=1
HEALTH_SCORE_V2=1
# Enable Portion V2 resolution (new 5-tier fallback system)
ENABLE_PORTION_V2=false
# Enable branded food search via FDC API
ENABLE_BRANDED_SEARCH=false

# Sentry Configuration
SENTRY_DB_SPAN_SAMPLE=1

# Development API Key (for testing)
DEV_API_KEY=your-dev-api-key

# Demo user email (defaults to demo@example.com if not set)
DEMO_USER_EMAIL=demo@example.com



# Cron Jobs
# Secret key for authenticating cron job requests
CRON_SECRET=your-cron-secret-key

# Debug Flags
# Enable nutrition calculation debug logging (set to "1" to enable)
NUTRITION_DEBUG=0
# Test flag for development/testing (set to "1" or "true" to enable)
TEST_FLAG=false

# Vercel Environment Variables (Auto-set by Vercel, documented for reference)
# These are automatically set by Vercel during deployment/build
# You typically don't need to set these manually
VERCEL_ENV=production
VERCEL=1
NEXT_PHASE=phase-production-build
NEXT_RUNTIME=nodejs
BUILD_TIME=true

# FatSecret Platform API
FATSECRET_CLIENT_ID=1111111111111111111111111111
FATSECRET_CLIENT_SECRET=1111111111111111111111111111
ENABLE_FATSECRET=true
FATSECRET_MIN_CONFIDENCE=0.7
FATSECRET_TIMEOUT_MS=2500
FATSECRET_REGION=US
# FatSecret OAuth scopes (space-separated). Required for barcode lookup: "premier barcode"
# Recipes endpoints may require "recipes": e.g., FATSECRET_SCOPE="premier barcode recipes"
# Default: "premier"
FATSECRET_SCOPE="premier barcode"
# FatSecret barcode lookup region (2-letter ISO-style code)
# Use a 2-letter region code (US, UK, DE, FR, AU, CA, SG, etc.)
# Default: "US"
FATSECRET_BARCODE_REGION=US
# FatSecret strict mode (default: true)
# When true: only use FatSecret results if confidence >= FATSECRET_MIN_CONFIDENCE
# When false: accept any FatSecret result with confidence >= 0.4 (do not treat as fallback)
# Recommendation: Set to false for dev/testing to maximize FatSecret usage and improve coverage
# Note: The search pipeline includes synonym expansion (e.g., "almond flour" -> "almond meal"), 
# singular forms, and ultra-generic fallbacks (including final "noun only" queries) for pantry staples.
# Update INGREDIENT_SYNONYMS in map-ingredient.ts if you add more pantry categories.
# In eval mode (fatsecret/hybrid), P@1 now treats high-confidence (>= 0.8) FatSecret matches as hits
# even if names differ, avoiding false negatives from different naming conventions.
FATSECRET_STRICT_MODE=true
# FatSecret cache mode: legacy | shadow | dual | primary
FATSECRET_CACHE_MODE=legacy
# FatSecret cache configuration (Phase 1+)
# Entries older than this many minutes will be considered stale and refreshed
FATSECRET_CACHE_MAX_AGE_MINUTES=720
# Maximum foods to hydrate per batch run
FATSECRET_CACHE_SYNC_BATCH_SIZE=25
# Optional internal endpoint to request AI density estimates (leave blank to disable)
FATSECRET_CACHE_DENSITY_AI_ENDPOINT=
# See docs/FATSECRET_MIGRATION.md for cache schema and rollout details.
# FatSecret retrieval lane (Phase 1): fs candidates compete in rerank on cache miss (kill-switch, default false)
FATSECRET_RETRIEVAL_ENABLED=false
# Per-call timeout for the retrieval lane's search request (ms) — lane is fail-open on timeout
FATSECRET_LANE_TIMEOUT_MS=800
# Max fs candidates fetched per lane search
FATSECRET_LANE_MAX_RESULTS=8
# How many NON-WINNING fs hits per query may be written to our own cache. The winner is
# always persisted (FoodMapping.fsId is an FK to FatSecretFood.fsId), so the per-query
# ceiling is this + 1. Default 0 = cache only foods that actually won a mapping; a user
# override that picks a candidate we never stored refetches that one record on demand.
FATSECRET_PERSIST_RUNNERS_UP=0
# Persisted FatSecretFood rows older than this many days are refreshed in the background
FATSECRET_REFRESH_DAYS=30

# Eval harness mode: local (default), fatsecret, hybrid (fatsecret-first with fallback), or problem
# Note: npm run eval -- --fatsecret ... still works and forces fatsecret mode for that invocation
# Use EVAL_MODE=problem to automatically load eval/gold.fatsecret-problem-set.csv (20 rows) for quick sanity checks
# Tip: For quick testing without hammering the API, use: EVAL_MODE=fatsecret && npm run eval -- eval/gold.fatsecret-problems.csv
# Quick regression set: eval/gold.fatsecret-problems.csv (20 rows) - use for fast iteration without full API usage
#   This CSV is automatically used by scripts/fatsecret-problem-debug.ts when no path is provided
# Warning: Running the full gold.v3.csv eval hits the live FatSecret API extensively (~265 API calls)
EVAL_MODE=local


# AI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
FATSECRET_CACHE_AI_MODEL=gpt-5-nano
FATSECRET_CACHE_AI_CONFIDENCE_MIN=0.6
FATSECRET_CACHE_AI_MIN_DENSITY=0.05
FATSECRET_CACHE_AI_MAX_DENSITY=5
FATSECRET_CACHE_AI_ENABLED=true
# Minimum confidence threshold for AI-generated serving backfill
FATSECRET_CACHE_AI_BACKFILL_CONFIDENCE_MIN=0.5
OPENAI_API_BASE_URL=https://api.openai.com/v1

# OPENROUTER
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model used by Tier L of scripts/eval/correctness-screen.ts (the post-warm batch
# correctness screen). Measured at openai/gpt-4o-mini, temperature 0: ~62 calls,
# ~$0.011 and ~11s per batch. Changing it invalidates the measured operating point —
# re-run the screen with --labels against a hand-labelled batch before trusting it.
SCREEN_AI_MODEL=openai/gpt-4o-mini

# Ollama (local LLM for parse tasks — $0 cost)
# DEFAULTS TO TRUE when unset (getFlag('OLLAMA_ENABLED', true) in src/lib/mapping/config.ts),
# and the Ollama provider entry carries its own literal apiKey, so it is the one provider that
# is armed WITHOUT any credential being configured. Undocumented here until 2026-08-02 because
# config.ts reads it through a dynamic process.env[name], which the .env.example parity check
# cannot see — it surfaced only when a test referenced the name literally.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT_MS=15000

# AI Model Configuration
# Primary and fallback models used for cheap structured tasks (segmentation,
# normalization, serving estimation). Must be VALID OpenRouter model IDs —
# an invalid slug fails HTTP 400 on every call and silently burns a round
# trip before the fallback serves it (google/gemini-2.0-flash died this way
# when OpenRouter retired the model; verify against /api/v1/models).
# gpt-4o-mini beat gemini-2.5-flash/-lite on multi-item segmentation in the
# 2026-07-20 golden-eval bake-off (0 vs 2 real seg failures) and is cheaper
# than 2.5-flash.
CHEAP_AI_MODEL_PRIMARY=openai/gpt-4o-mini
CHEAP_AI_MODEL_FALLBACK=google/gemini-2.5-flash
# Model for AI nutrition estimation (last-resort fallback)
NUTRITION_AI_MODEL=openai/gpt-4o-mini
# Structured LLM client timeout and retry config
STRUCTURED_LLM_TIMEOUT_MS=30000
STRUCTURED_LLM_MAX_RETRIES=2

# AI Nutrition Backfill (last-resort for unmappable ingredients)
# Budget a batch/warm RUN asks for (scripts create one budget and share it).
AI_NUTRITION_MAX_PER_BATCH=20
# Budget for a SINGLE /api/nlp/parse request — not a process ceiling. 0 fails closed.
AI_NUTRITION_MAX_PER_REQUEST=3

# AI Nutrition HYDRATION (enrichment inside buildOffResult) — a SECOND, SEPARATE
# allowance. Spent when an OFF record that already WON retrieval has a per-100g
# panel the Atwater gate rejects. Deliberately not the budget above: exhausting
# the last-resort budget degrades a line that had no match anyway, but exhausting
# hydration makes buildOffResult return null and DELETES that candidate, so the
# pipeline caches a different record — which under one shared pool made a sticky
# FoodMapping row depend on what else was concurrently in flight.
# Sized generously (hydration is bounded by candidate count, and the AI-nutrition
# cache is checked BEFORE the budget, so repeat names are free).
# Per RUN for batch/warm scripts; warm-names CLI override: --hydration-budget N.
AI_NUTRITION_HYDRATION_MAX_PER_BATCH=200
# Per SINGLE /api/nlp/parse request. 0 fails the hydration path closed.
AI_NUTRITION_HYDRATION_MAX_PER_REQUEST=20

# Pipeline Feature Flags
# Pre-emptive category-specific serving generation after first mapping
ENABLE_PREEMPTIVE_BACKFILL=false
# Generate detailed mapping analysis logs in logs/mapping-analysis-*.json
ENABLE_MAPPING_ANALYSIS=false
# Append every AI parse-assist call to logs/ai-parse-events.jsonl. SYNCHRONOUS
# appendFileSync on a request path — leave off in production. The structured
# mapping.ai_parse_* logger lines are emitted regardless of this flag.
ENABLE_AI_PARSE_LOG=false
# Print rerank scores to console (noisy — for debugging only)
DEBUG_RERANK_SCORES=false

# Logging
# Set to error, warn, info, or debug
LOG_LEVEL=warn

# Meilisearch Configuration (legacy — superseded by Typesense below)
# The URL to the local Meilisearch service (e.g., http://localhost:7700)
MEILISEARCH_HOST=http://localhost:7700
# Meilisearch API Key
MEILISEARCH_API_KEY=your-meilisearch-api-key

# Typesense Configuration (current search provider)
# The URL to the local Typesense service (e.g., http://localhost:8108)
TYPESENSE_HOST=http://localhost:8108
# Typesense API key
TYPESENSE_API_KEY=xyzapikey

# Semantic (vector) search toggle — set to "true" to enable bge-small query
# embedding + pgvector ANN in the OFF candidate gather step. Requires the
# `vector` extension and populated OffFood.embedding column.
SEMANTIC_SEARCH_ENABLED=false

# DIAGNOSTIC ONLY — leave unset in every deployed environment.
# Forces query-side pooling ('cls' | 'mean'). The corpus is CLS-pooled, so the
# only correct value is the default (CORPUS_POOLING in
# src/lib/search/query-embedding.ts); setting 'mean' deliberately puts queries in
# a different vector space and exists so scripts/eval/semantic-recall-probe.ts can
# A/B the two in one process. It logs a warning whenever it is honoured.
# Left empty deliberately: the code treats empty exactly as unset, so this
# documents the knob and satisfies .env.example parity without pinning a value.
EMBED_QUERY_POOLING=

# Per-line mapping telemetry (MappingEventLog table) written by /api/nlp/parse:
# cache hit/escape, serving-resolution tier, billed totals, latency. Default on;
# set to "false" to disable writes (reads/analytics unaffected).
MAPPING_EVENT_LOG_ENABLED=true

# Identity-preserving cache keys (PR D pt3, Lever C): appends whitelisted
# discriminators (egg white/yolk unit hints, cooked/whole qualifiers) to
# ValidatedMapping cache keys so e.g. "egg whites" and "egg" stop sharing a
# row. Kill-switch: set to "0" for plain canonicalized keys (legacy behavior).
CACHE_KEY_DISCRIMINATORS=1

# Bare-query serving guard (PR D pt3, Lever A): caps package-scale servings and
# replaces fabricated 100g floors with category defaults for unitless qty-1
# queries ("olive oil" bills ~14g, not the 250g bottle). Kill-switch: "0".
OFF_BARE_SERVING_GUARD=1

# Rank-time plausibility partition (PR D pt3, Lever B): rerank sorts floor-hit
# candidates (implausible macros for the query, or triage-denylisted corrupt
# OFF records) strictly below plausible ones — demoted, never dropped.
# Kill-switch: "0" restores prior ordering.
RANK_PLAUSIBILITY_PARTITION=1

# Brand macro-consensus outlier demotion (fs displacement hardening, Jul 2026):
# under the decisive-brand gate, when >=3 same-brand nutrition-bearing siblings
# mostly agree on the per-100g panel, the rerank demotes a sibling whose
# protein/kcal deviates hard from the median (plausible-wrong label data).
# Kill-switch: "0" disables the pass.
RANK_BRAND_CONSENSUS=1

# Same-brand VARIANT precision (rerank): when the query names a brand, honor a
# requested size/count and penalize un-requested distinguishing qualifiers
# ("double", "ultimate"...) so "quarter pounder" doesn't map to "Double Quarter
# Pounder" and "arbys curly fries medium" doesn't map to Small. Kill-switch: "0".
RANK_BRAND_VARIANT=1

# Branded-match confidence CALIBRATION (rerank): lift confidence to ~0.88 for a
# tight same-brand exact match (brand matches, full non-brand token coverage, no
# extra descriptor, not floor-hit/consensus-demoted) so correct branded records
# clear the 0.85 cache gate. Strict by construction. Kill-switch: "0".
RANK_BRANDED_CALIBRATION=1

# Human-triage cache-row trust (PR D pt3, Lever B): FoodMapping rows with
# validatedBy='human-triage' skip name-heuristic cache escapes at read time
# (nutrition-invalid and serving-shape escapes stay active). Kill-switch: "0".
HUMAN_ROW_TRUST=1

# Corrupt-record exclusion (mark-corrupt PR): OffFood rows with a non-null
# corruptReason (written by scripts/mark-corrupt-off.ts) are filtered from the
# Postgres fallback search, and FoodMapping cache rows pointing at them escape
# at read time ('corrupt_record') so they re-resolve. Index-level exclusion
# (sync-typesense WHERE + purge script) is data-level and unaffected by this
# flag. Kill-switch: "0".
CORRUPT_RECORD_EXCLUSION=1

# OpenFoodFacts Configuration
# Enable/disable OpenFoodFacts candidate search (default: true)
OFF_ENABLED=true
# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Structured-log threshold, read by `logger` in src/lib/logger.ts. One of
# debug|info|warn|error|silent. Unset defaults to `warn` in production and
# `debug` elsewhere, which reproduces the volume the box already emits.
# HISTORY: LOG_LEVEL=warn was already set in a box .env while ZERO lines of code
# read it — a configured knob nothing consumed. It is consumed now. Raising this
# to `info` is a debugging-window action (restart required, no rebuild); the log
# is append-only with no logrotate, so put it back afterwards. `audit`-level
# events are NOT gated by this and are always emitted.
LOG_LEVEL=warn

# Prisma's raw `query` log stream. Off by default: measured 2026-08-01, it was
# 909,552 of 976,124 lines (93.2%) of the API log, which made the file
# ungreppable. Set to "1" and restart to re-enable for a debugging window.
PRISMA_LOG_QUERIES=0
